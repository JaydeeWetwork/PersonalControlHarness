# silica_tilled: dark tilled rows with violet furrows (grid max-blended over
# a clamped soil-dark base; furrow lines reach the violet palette top).
noise kind=gradient scale=6 octaves=4 seed=131
curve contrast=1.3 clamp_max=0.48
grid cells=3 width=0.22 sharpness=1.2
blend mode=max mix=1
palette stops=0:#0c0918,0.3:#181126,0.48:#291c44,0.75:#4b2f86,0.92:#9d7bff,1:#cdb4ff
