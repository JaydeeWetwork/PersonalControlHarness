# slicor (item icon): the sword -- bright blade field, glowing blue fuller
# line, red gem point at the pommel.
noise kind=gradient scale=2 octaves=2 seed=451
curve contrast=1.35 clamp_max=0.45
grid cells=1 width=0.2 sharpness=1.4
blend mode=max mix=1
palette stops=0:#0a0a12,0.4:#1c1f2e,0.6:#5b6478,0.8:#c3cad6,0.92:#35e0ff,1:#ff4d4d
glow threshold=0.88 intensity=0.5 color=#35e0ff
