{
  "version": 1,
  "analog": {
    "stickDeadzone": 0.2,
    "triggerDeadzone": 0.1,
    "stickCurve": 2,
    "mouseSensitivity": 0.0025,
    "stickLookSpeed": 3,
    "invertY": false,
    "pressThreshold": 0.5
  },
  "bindings": {
    "MoveForward": ["key:W", "padaxis:LeftY-"],
    "MoveBack": ["key:S", "padaxis:LeftY+"],
    "MoveLeft": ["key:A", "padaxis:LeftX-"],
    "MoveRight": ["key:D", "padaxis:LeftX+"],
    "Jump": ["key:Space", "pad:A"],
    "Sneak": ["key:LeftShift", "pad:B"],
    "Crawl": ["key:C", "pad:DpadRight"],
    "Sprint": ["key:LeftCtrl", "pad:LeftThumb"],
    "Break": ["mouse:Left", "padaxis:RightTrigger+"],
    "Place": ["mouse:Right", "padaxis:LeftTrigger+"],
    "Use": ["mouse:Right", "pad:X"],
    "PickBlock": ["mouse:Middle", "pad:DpadUp"],
    "Inventory": ["key:E", "pad:Y"],
    "Drop": ["key:Q", "pad:DpadDown"],
    "Hotbar1": ["key:Num1"],
    "Hotbar2": ["key:Num2"],
    "Hotbar3": ["key:Num3"],
    "Hotbar4": ["key:Num4"],
    "Hotbar5": ["key:Num5"],
    "Hotbar6": ["key:Num6"],
    "Hotbar7": ["key:Num7"],
    "Hotbar8": ["key:Num8"],
    "Hotbar9": ["key:Num9"],
    "HotbarNext": ["wheel:Down", "pad:RightBumper"],
    "HotbarPrev": ["wheel:Up", "pad:LeftBumper"],
    "ToggleHUD": ["key:F1"],
    "ToggleDebug": ["key:F3", "pad:Back"],
    "ToggleControls": ["key:H", "pad:DpadLeft"],
    "CycleTPS": ["key:F7"],
    "SwitchDim": ["key:F6"],
    "ToggleEUV": ["key:F8"],
    "ReloadResources": ["key:F9"],
    "ScriptEditor": ["key:F10"],
    "SaveWorld": ["key:F5"],
    "Pause": ["key:Escape", "pad:Start"],
    "Look": ["mouse:Motion", "stick:Right"]
  }
}
