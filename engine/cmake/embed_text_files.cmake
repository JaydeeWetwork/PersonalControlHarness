# Generates a header with text files as raw string literals, so a module has a built-in fallback
# that is always identical to the files in assets/ (single source of truth). Used for the base
# shaders (render) and the built-in world generators (world).
# Usage: cmake -DDIR=<dir> -DPATTERNS=<*.a,*.b> -DOUT=<file> -DSTRUCT=<type> -DARRAY=<name>
#              -P embed_text_files.cmake
# Output: struct STRUCT { const char* name; const char* source; }; ARRAY[] = {{file, text}, ...}
string(REPLACE "," ";" patterns "${PATTERNS}")
set(globs "")
foreach(p ${patterns})
  list(APPEND globs ${DIR}/${p})
endforeach()
file(GLOB files RELATIVE ${DIR} ${globs})
list(SORT files)
set(body "// Generated by cmake/embed_text_files.cmake. Do not edit.\n#pragma once\n")
string(APPEND body "struct ${STRUCT} { const char* name; const char* source; };\n")
string(APPEND body "inline constexpr ${STRUCT} ${ARRAY}[] = {\n")
foreach(f ${files})
  file(READ ${DIR}/${f} src)
  string(APPEND body "  {\"${f}\", R\"vcembed(${src})vcembed\"},\n")
endforeach()
string(APPEND body "};\n")
if(EXISTS ${OUT})
  file(READ ${OUT} old)
endif()
if(NOT "${old}" STREQUAL "${body}")
  file(WRITE ${OUT} "${body}")
endif()
